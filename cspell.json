{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "dictionaries": ["custom-words"],
  "dictionaryDefinitions": [
    {
      "name": "custom-words",
      "path": "custom_words.txt",
      "addWords": true
    }
  ],
  "ignorePaths": [
    "**/.git/**",
    "**/.terraform/**",
    "**/bin/**",
    "go.mod",
    "go.sum",
    "flake.lock",
    "test/**",
    "tools/**",
    "examples/**",
    "docs/**",
    "CHANGELOG.md",
    "**/go.mod",
    "**/go.sum",
    "modules/**",
    "*.tf",
    "*.sh",
    "*.sh.tpl",
    "cleanup.sh"
  ]
}
